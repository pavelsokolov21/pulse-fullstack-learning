    "/monitors/{monitor_id}/report": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Monitor Report",
        "description": "Аптайм и задержки (среднее, p95) монитора за окно.\n\nЗаголовок `X-Cache`: `HIT`, если отчёт отдан из кеша, `MISS`, если посчитан по\nбазе. Новая проверка монитора сбрасывает кеш сразу.",
        "operationId": "get_monitor_report",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "monitor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Monitor Id"
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReportWindow",
