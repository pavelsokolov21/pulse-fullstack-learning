  "components": {
    "schemas": {
      "Body_login": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_login"
      },
      "CheckRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "monitor_id": {
            "type": "integer",
            "title": "Monitor Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "status_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Code"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Checked At"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          }
        },
        "type": "object",
        "required": [
          "id",
          "monitor_id",
          "url",
          "status_code",
          "latency_ms",
          "error",
          "checked_at",
          "ok"
        ],
        "title": "CheckRead",
        "description": "Проверка монитора в ответе API."
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "description": "Единое тело ошибки: код для программы и сообщение для человека."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type",
          "msg"
        ],
        "title": "FieldError"
      },
      "MonitorCreate": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "interval": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "title": "Interval"
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Timeout",
            "default": 10.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "interval"
        ],
        "title": "MonitorCreate",
        "description": "Тело POST /monitors."
      },
      "MonitorRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "owner_id": {
            "type": "integer",
            "title": "Owner Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "interval": {
            "type": "number",
            "title": "Interval"
          },
          "timeout": {
            "type": "number",
            "title": "Timeout"
          }
        },
        "type": "object",
        "required": [
          "id",
          "owner_id",
          "url",
          "interval",
          "timeout"
        ],
        "title": "MonitorRead",
        "description": "Монитор в ответе API. Данные из хранилища уже валидны: не проверяем снова."
      },
      "MonitorUpdate": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "interval": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval"
          },
          "timeout": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MonitorUpdate",
        "description": "Тело PATCH /monitors/{id}: меняются только переданные поля.\n\nОтсутствие поля означает «не менять», а явный `null` запрещён: у монитора\nнет необязательных полей, которые можно очистить."
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "description": "Тело POST /auth/register."
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "manager",
          "viewer"
        ],
        "title": "Role",
        "description": "Какие действия разрешены (глаголы). С какими объектами, решает владение."
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
