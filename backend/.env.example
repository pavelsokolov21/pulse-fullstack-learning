# Образец для `uv run poe dev`. Скопируйте в .env.dev (он в .gitignore) и подставьте значения:
#   cp .env.example .env.dev
# Ключ подписи JWT, не короче 32 символов:  openssl rand -hex 32
PULSE_API_JWT_SECRET=
# Роль pulse_app, пароль из db/roles.sql
PULSE_API_DATABASE_URL=postgresql+psycopg://pulse_app:ПАРОЛЬ@127.0.0.1:5432/pulse_schema
# REDIS_PASSWORD из корневого .env
PULSE_API_REDIS_URL=redis://:ПАРОЛЬ_REDIS@127.0.0.1:6379/0
# За прокси Next.js (rewrites /api/*) cookie с refresh ходит на /api/auth
PULSE_API_REFRESH_COOKIE_PATH=/api/auth
# Очередь фоновых задач (Celery). Тот же адрес, что PULSE_WORKER_BROKER_URL в .env.worker;
# Redis, база №1 (кеш приложения живёт в базе №0). Не задан: уведомления не ставятся.
# PULSE_API_TASKS_BROKER_URL=redis://:ПАРОЛЬ_REDIS@127.0.0.1:6379/1
# Воркер читает свои значения из отдельного файла .env.worker (cp на основе строк ниже):
#   PULSE_WORKER_BROKER_URL=redis://:ПАРОЛЬ_REDIS@127.0.0.1:6379/1
#   PULSE_WORKER_DATABASE_URL=postgresql+psycopg://pulse_app:ПАРОЛЬ@127.0.0.1:5432/pulse_schema
#   PULSE_WORKER_NOTIFY_WEBHOOK_URL=   (необязательно)
